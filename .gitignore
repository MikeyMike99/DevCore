# On-device dictation assets, fetched by scripts/fetch_speech_assets.py
sandbox/static/speech/vendor/
sandbox/static/speech/models/

# e_profile is its own git repo (github.com/MikeyMike99/E-profile), kept here as a playground project.
# Never commit it into DevCore: it holds .ssh keys, .env and the vault.
playground/e_profile/

